# Application
ENVIRONMENT=development
APP_BASE_URL=http://localhost:5173

# Database
# Docker Compose maps host port 5433 to avoid clashing with a local PostgreSQL on 5432.
DATABASE_URL=postgresql+psycopg://helpdesk:helpdesk@localhost:5433/helpdesk

# Secrets: replace these outside local development.
SESSION_SECRET=dev-only-change-me
WEBHOOK_SECRET=dev-only-change-me

# Email (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=helpdesk@example.test
